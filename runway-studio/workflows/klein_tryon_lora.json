{
  "1": { "class_type": "UNETLoader", "_meta": { "title": "Load FLUX.2 Klein 4B" },
         "inputs": { "unet_name": "flux-2-klein-4b-fp8.safetensors", "weight_dtype": "default" } },
  "31": { "class_type": "LoraLoaderModelOnly", "_meta": { "title": "Try-on LoRA" },
          "inputs": { "model": ["1", 0], "lora_name": "tryon-klein-4b.safetensors", "strength_model": 1.0 } },
  "2": { "class_type": "CLIPLoader", "_meta": { "title": "Load text encoder" },
         "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "flux2", "device": "default" } },
  "3": { "class_type": "VAELoader", "_meta": { "title": "Load VAE" },
         "inputs": { "vae_name": "flux2-vae.safetensors" } },
  "4": { "class_type": "CLIPTextEncode", "_meta": { "title": "Prompt" },
         "inputs": { "text": "{{PROMPT}}", "clip": ["2", 0] } },
  "5": { "class_type": "ConditioningZeroOut", "_meta": { "title": "Negative" },
         "inputs": { "conditioning": ["4", 0] } },
  "20": { "class_type": "LoadImage", "_meta": { "title": "Model image" },
          "inputs": { "image": "{{IMAGE_1}}" } },
  "21": { "class_type": "LoadImage", "_meta": { "title": "Dress image" },
          "inputs": { "image": "{{IMAGE_2}}" } },
  "22": { "class_type": "ImageScaleToTotalPixels", "_meta": { "title": "Resize model" },
          "inputs": { "image": ["20", 0], "upscale_method": "nearest-exact", "megapixels": 1, "resolution_steps": 1 } },
  "23": { "class_type": "ImageScaleToTotalPixels", "_meta": { "title": "Resize dress" },
          "inputs": { "image": ["21", 0], "upscale_method": "nearest-exact", "megapixels": 1, "resolution_steps": 1 } },
  "24": { "class_type": "GetImageSize", "_meta": { "title": "Size" },
          "inputs": { "image": ["22", 0] } },
  "25": { "class_type": "VAEEncode", "_meta": { "title": "Encode model" },
          "inputs": { "pixels": ["22", 0], "vae": ["3", 0] } },
  "26": { "class_type": "VAEEncode", "_meta": { "title": "Encode dress" },
          "inputs": { "pixels": ["23", 0], "vae": ["3", 0] } },
  "27": { "class_type": "ReferenceLatent", "_meta": { "title": "Reference: person" },
          "inputs": { "conditioning": ["4", 0], "latent": ["25", 0] } },
  "28": { "class_type": "ReferenceLatent", "_meta": { "title": "Reference: top" },
          "inputs": { "conditioning": ["27", 0], "latent": ["26", 0] } },
  "32": { "class_type": "ReferenceLatent", "_meta": { "title": "Reference: bottom" },
          "inputs": { "conditioning": ["28", 0], "latent": ["26", 0] } },
  "29": { "class_type": "ReferenceLatent", "_meta": { "title": "Reference: person (neg)" },
          "inputs": { "conditioning": ["5", 0], "latent": ["25", 0] } },
  "30": { "class_type": "ReferenceLatent", "_meta": { "title": "Reference: top (neg)" },
          "inputs": { "conditioning": ["29", 0], "latent": ["26", 0] } },
  "33": { "class_type": "ReferenceLatent", "_meta": { "title": "Reference: bottom (neg)" },
          "inputs": { "conditioning": ["30", 0], "latent": ["26", 0] } },
  "6": { "class_type": "EmptyFlux2LatentImage", "_meta": { "title": "Canvas" },
         "inputs": { "width": ["24", 0], "height": ["24", 1], "batch_size": 1 } },
  "7": { "class_type": "Flux2Scheduler", "_meta": { "title": "Scheduler" },
         "inputs": { "steps": 4, "width": ["24", 0], "height": ["24", 1] } },
  "8": { "class_type": "KSamplerSelect", "_meta": { "title": "Sampler" },
         "inputs": { "sampler_name": "euler" } },
  "9": { "class_type": "RandomNoise", "_meta": { "title": "Seed" },
         "inputs": { "noise_seed": "{{SEED}}" } },
  "10": { "class_type": "CFGGuider", "_meta": { "title": "Guider" },
          "inputs": { "model": ["31", 0], "positive": ["32", 0], "negative": ["33", 0], "cfg": 1 } },
  "11": { "class_type": "SamplerCustomAdvanced", "_meta": { "title": "Dressing the model (LoRA)" },
          "inputs": { "noise": ["9", 0], "guider": ["10", 0], "sampler": ["8", 0], "sigmas": ["7", 0], "latent_image": ["6", 0] } },
  "12": { "class_type": "VAEDecode", "_meta": { "title": "Decoding" },
          "inputs": { "samples": ["11", 0], "vae": ["3", 0] } },
  "13": { "class_type": "SaveImage", "_meta": { "title": "Save" },
          "inputs": { "images": ["12", 0], "filename_prefix": "runway-studio/tryon-lora" } }
}
