{
  "40": { "class_type": "LoadImage", "_meta": { "title": "Look image" },
          "inputs": { "image": "{{IMAGE_1}}" } },
  "41": { "class_type": "CheckpointLoaderSimple", "_meta": { "title": "Load LTX-2.3" },
          "inputs": { "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors" } },
  "42": { "class_type": "LTXVAudioVAELoader", "_meta": { "title": "Load audio VAE" },
          "inputs": { "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors" } },
  "43": { "class_type": "LTXAVTextEncoderLoader", "_meta": { "title": "Load Gemma text encoder" },
          "inputs": { "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors", "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors", "device": "default" } },
  "44": { "class_type": "CLIPTextEncode", "_meta": { "title": "Scene prompt" },
          "inputs": { "text": "{{PROMPT}}", "clip": ["43", 0] } },
  "45": { "class_type": "CLIPTextEncode", "_meta": { "title": "Negative prompt" },
          "inputs": { "text": "blurry, out of focus, low quality, distorted body, extra limbs, deformed hands, deformed face, flickering, jittery motion, morphing clothes, changing dress, warped fabric, text, watermark, cartoon, CGI look", "clip": ["43", 0] } },
  "46": { "class_type": "LTXVConditioning", "_meta": { "title": "Frame-rate conditioning" },
          "inputs": { "positive": ["44", 0], "negative": ["45", 0], "frame_rate": "{{FPS}}" } },
  "47": { "class_type": "ImageScale", "_meta": { "title": "Fit to video size" },
          "inputs": { "image": ["40", 0], "upscale_method": "bilinear", "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "crop": "center" } },
  "48": { "class_type": "LTXVPreprocess", "_meta": { "title": "Prepare first frame" },
          "inputs": { "image": ["47", 0], "img_compression": 25 } },
  "49": { "class_type": "EmptyLTXVLatentVideo", "_meta": { "title": "Video canvas" },
          "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "length": "{{FRAMES}}", "batch_size": 1 } },
  "50": { "class_type": "LTXVAddGuide", "_meta": { "title": "Lock first frame" },
          "inputs": { "positive": ["46", 0], "negative": ["46", 1], "vae": ["41", 2], "latent": ["49", 0], "image": ["48", 0], "frame_idx": 0, "strength": 1.0 } },
  "51": { "class_type": "LTXVEmptyLatentAudio", "_meta": { "title": "Audio canvas" },
          "inputs": { "frames_number": "{{FRAMES}}", "frame_rate": "{{FPS}}", "batch_size": 1, "audio_vae": ["42", 0] } },
  "52": { "class_type": "LTXVConcatAVLatent", "_meta": { "title": "Join audio + video" },
          "inputs": { "video_latent": ["50", 2], "audio_latent": ["51", 0] } },
  "53": { "class_type": "RandomNoise", "_meta": { "title": "Seed" },
          "inputs": { "noise_seed": "{{SEED}}" } },
  "54": { "class_type": "CFGGuider", "_meta": { "title": "Guider" },
          "inputs": { "model": ["41", 0], "positive": ["50", 0], "negative": ["50", 1], "cfg": 1 } },
  "55": { "class_type": "SamplerEulerAncestral", "_meta": { "title": "Sampler" },
          "inputs": { "eta": 0, "s_noise": 1 } },
  "56": { "class_type": "ManualSigmas", "_meta": { "title": "Distilled schedule" },
          "inputs": { "sigmas": "1., 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0" } },
  "57": { "class_type": "SamplerCustomAdvanced", "_meta": { "title": "Rendering video" },
          "inputs": { "noise": ["53", 0], "guider": ["54", 0], "sampler": ["55", 0], "sigmas": ["56", 0], "latent_image": ["52", 0] } },
  "58": { "class_type": "LTXVSeparateAVLatent", "_meta": { "title": "Split audio + video" },
          "inputs": { "av_latent": ["57", 1] } },
  "59": { "class_type": "LTXVCropGuides", "_meta": { "title": "Drop guide frames" },
          "inputs": { "positive": ["50", 0], "negative": ["50", 1], "latent": ["58", 0] } },
  "60": { "class_type": "VAEDecodeTiled", "_meta": { "title": "Decoding video" },
          "inputs": { "samples": ["59", 2], "vae": ["41", 2], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8 } },
  "61": { "class_type": "LTXVAudioVAEDecode", "_meta": { "title": "Decoding audio" },
          "inputs": { "samples": ["58", 1], "audio_vae": ["42", 0] } },
  "62": { "class_type": "CreateVideo", "_meta": { "title": "Muxing" },
          "inputs": { "images": ["60", 0], "audio": ["61", 0], "fps": "{{FPS}}" } },
  "63": { "class_type": "SaveVideo", "_meta": { "title": "Save video" },
          "inputs": { "video": ["62", 0], "filename_prefix": "runway-studio/runway", "format": "auto", "codec": "auto" } }
}
